std = "lua51"
max_line_length = 200
allow_defined_top = true
exclude_files = { "tests/", "Libs/", "embeds/" }

ignore = {
	"631", -- line is too long
	"212", -- unused argument
	"431", -- shadowing upvalue
	"131", -- unused global variable (e.g. SLASH commands)
	"143", -- accessing field of read-only global
}

